import java.util.Scanner;
class SumOfDigitsUntilSingleDigit  
{
	public static void main(String[] args) 
	{
		System.out.println("Enter a num: ");
		Scanner scn=new Scanner(System.in);
		long n=scn.nextLong();
		long sum=0;
		while(n > 0){
			sum += n % 10;
			n /= 10;
			if (n == 0 && sum > 9){
				n = sum;
				sum = 0;
			}
		}
			System.out.println(sum);
	}
}